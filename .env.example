# --- Supabase (web) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by Drizzle (Supabase "Connection pooling" URI)
DATABASE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=KeyLeads <onboarding@resend.dev>

# --- Collector service (optional; enables Indeed + Glassdoor via python-jobspy) ---
COLLECTOR_URL=
COLLECTOR_TOKEN=

# --- Job source API keys (optional; adapter is skipped and shown "not configured" when empty) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
JOOBLE_API_KEY=
JOOBLE_API_URL=https://jooble.org
MUSE_API_KEY=
FINDWORK_API_KEY=
RAPIDAPI_KEY=
REED_API_KEY=
USAJOBS_KEY=
USAJOBS_EMAIL=
CAREERJET_KEY=

# --- Provider-backed sources ---
APIFY_TOKEN=
APIFY_WELLFOUND_ACTOR=curious_coder~wellfound-scraper

# LinkedIn transport: leave empty to disable the guest scraper
LINKEDIN_TRANSPORT=guest
